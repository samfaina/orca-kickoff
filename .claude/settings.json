{
   "permissions": {
    "allow": [
      "Bash(npx -y -p typescript@5.6.3 tsc -p .)",
      "PowerShell(npx -y -p typescript@5.6.3 tsc -p .)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr merge*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-hook.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*gh pr merge*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-hook.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
